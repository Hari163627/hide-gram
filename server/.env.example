# ═══════════════════════════════════════════
# server/.env.example
# ───────────────────────────────────────────
# Это ШАБЛОН. НЕ используй его для запуска.
# Скопируй в server/.env и заполни своими значениями.
# Файл .env НЕ попадает в Git (он в .gitignore).
# ═══════════════════════════════════════════

# ─── Supabase ───
# Взять здесь: Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# ─── База данных ───
# Взять здесь: Supabase → Connect → ORMs → Prisma
# ВАЖНО: замени [YOUR-PASSWORD] на реальный пароль БД
# ВАЖНО: DATABASE_URL — порт 6543, DIRECT_URL — порт 5432
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# ─── Telegram-боты ───
# Получить у @BotFather: /newbot
BOT_TOKEN_ADMIN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
BOT_TOKEN_USER=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ─── Админ ───
# Узнать у @userinfobot — свой числовой Telegram ID
ADMIN_TG_ID=123456789

# ─── Сервер ───
PORT=3000
NODE_ENV=development

# Секрет для подписи JWT-токенов.
# Минимум 32 символа. Сгенерируй:
#   openssl rand -hex 32
#   или: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_random_64_char_string_minimum_32_chars

# ─── URLs ───
# Локально:
CLIENT_URL=http://localhost:5173
PUBLIC_URL=http://localhost:3000

# На Render (продакшен) замени на реальные:
# CLIENT_URL=https://hide-gram-web.onrender.com
# PUBLIC_URL=https://hide-gram-api.onrender.com
